{
  "name": "ParcelaGasto",
  "type": "object",
  "properties": {
    "gasto_id": {
      "type": "string",
      "description": "ID do gasto principal"
    },
    "numero_parcela": {
      "type": "number",
      "description": "N\u00famero da parcela"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da parcela"
    },
    "valor": {
      "type": "number",
      "description": "Valor da parcela"
    },
    "data_vencimento": {
      "type": "string",
      "format": "date",
      "description": "Data prevista para pagamento"
    },
    "data_pagamento": {
      "type": "string",
      "format": "date",
      "description": "Data em que a parcela foi paga"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "programado",
        "pago",
        "atrasado"
      ],
      "default": "pendente",
      "description": "Status da parcela"
    }
  },
  "required": [
    "gasto_id",
    "numero_parcela",
    "valor"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}