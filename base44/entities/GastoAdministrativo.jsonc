{
  "name": "GastoAdministrativo",
  "type": "object",
  "properties": {
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do gasto administrativo"
    },
    "categoria_id": {
      "type": "string",
      "description": "ID da categoria de gasto administrativo"
    },
    "valor": {
      "type": "number",
      "description": "Valor do gasto"
    },
    "data": {
      "type": "string",
      "format": "date",
      "description": "Data do gasto"
    },
    "fornecedor_id": {
      "type": "string",
      "description": "ID do fornecedor"
    },
    "forma_pagamento": {
      "type": "string",
      "enum": [
        "dinheiro",
        "cartao",
        "transferencia",
        "boleto",
        "pix"
      ],
      "description": "Forma de pagamento"
    },
    "status_pagamento": {
      "type": "string",
      "enum": [
        "pendente",
        "pago"
      ],
      "default": "pendente",
      "description": "Status do pagamento"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es sobre o gasto"
    }
  },
  "required": [
    "descricao",
    "categoria_id",
    "valor",
    "data"
  ],
  "rls": {
    "read": {},
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}