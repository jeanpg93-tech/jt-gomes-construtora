{
  "name": "Pessoa",
  "type": "object",
  "properties": {
    "tipo": {
      "type": "string",
      "enum": [
        "fisica",
        "juridica"
      ],
      "description": "Tipo de pessoa (f\u00edsica ou jur\u00eddica)"
    },
    "nome": {
      "type": "string",
      "description": "Nome completo ou raz\u00e3o social"
    },
    "nome_fantasia": {
      "type": "string",
      "description": "Nome fantasia (apenas para pessoa jur\u00eddica)"
    },
    "cpf_cnpj": {
      "type": "string",
      "description": "CPF ou CNPJ"
    },
    "rg": {
      "type": "string",
      "description": "RG (apenas para pessoa f\u00edsica)"
    },
    "data_nascimento": {
      "type": "string",
      "format": "date",
      "description": "Data de nascimento (pessoa f\u00edsica) ou data de funda\u00e7\u00e3o"
    },
    "estado_civil": {
      "type": "string",
      "enum": [
        "solteiro",
        "casado",
        "divorciado",
        "viuvo",
        "uniao_estavel"
      ],
      "description": "Estado civil"
    },
    "profissao": {
      "type": "string",
      "description": "Profiss\u00e3o"
    },
    "naturalidade": {
      "type": "string",
      "description": "Cidade/estado de nascimento (ex: Beberibe/CE)"
    },
    "cep": {
      "type": "string",
      "description": "CEP"
    },
    "logradouro": {
      "type": "string",
      "description": "Logradouro (rua, avenida, etc)"
    },
    "numero": {
      "type": "string",
      "description": "N\u00famero"
    },
    "complemento": {
      "type": "string",
      "description": "Complemento"
    },
    "bairro": {
      "type": "string",
      "description": "Bairro"
    },
    "cidade": {
      "type": "string",
      "description": "Cidade"
    },
    "estado": {
      "type": "string",
      "description": "Estado (UF)"
    },
    "endereco_completo": {
      "type": "string",
      "description": "Endere\u00e7o completo formatado"
    },
    "representante_nome": {
      "type": "string",
      "description": "Nome do representante legal (pessoa jur\u00eddica)"
    },
    "representante_cpf": {
      "type": "string",
      "description": "CPF do representante legal"
    },
    "representante_rg": {
      "type": "string",
      "description": "RG do representante legal"
    },
    "representante_data_nascimento": {
      "type": "string",
      "format": "date",
      "description": "Data de nascimento do representante"
    },
    "representante_estado_civil": {
      "type": "string",
      "enum": [
        "solteiro",
        "casado",
        "divorciado",
        "viuvo",
        "uniao_estavel"
      ],
      "description": "Estado civil do representante"
    },
    "representante_profissao": {
      "type": "string",
      "description": "Profiss\u00e3o do representante"
    },
    "representante_naturalidade": {
      "type": "string",
      "description": "Naturalidade do representante"
    },
    "representante_mesmo_endereco": {
      "type": "boolean",
      "description": "Se o representante reside no mesmo endere\u00e7o da empresa"
    },
    "representante_cep": {
      "type": "string",
      "description": "CEP do representante"
    },
    "representante_logradouro": {
      "type": "string",
      "description": "Logradouro do representante"
    },
    "representante_numero": {
      "type": "string",
      "description": "N\u00famero do endere\u00e7o do representante"
    },
    "representante_complemento": {
      "type": "string",
      "description": "Complemento do endere\u00e7o do representante"
    },
    "representante_bairro": {
      "type": "string",
      "description": "Bairro do representante"
    },
    "representante_cidade": {
      "type": "string",
      "description": "Cidade do representante"
    },
    "representante_estado": {
      "type": "string",
      "description": "Estado do representante"
    },
    "representante_endereco_completo": {
      "type": "string",
      "description": "Endere\u00e7o completo do representante"
    },
    "banco": {
      "type": "string",
      "description": "Nome do banco"
    },
    "agencia": {
      "type": "string",
      "description": "Ag\u00eancia banc\u00e1ria"
    },
    "conta_corrente": {
      "type": "string",
      "description": "N\u00famero da conta corrente"
    },
    "titular_conta": {
      "type": "string",
      "description": "Nome do titular da conta"
    },
    "cpf_cnpj_titular": {
      "type": "string",
      "description": "CPF/CNPJ do titular da conta"
    },
    "pix": {
      "type": "string",
      "description": "Chave PIX"
    },
    "telefone": {
      "type": "string",
      "description": "Telefone de contato"
    },
    "email": {
      "type": "string",
      "description": "E-mail"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es adicionais"
    }
  },
  "required": [
    "tipo",
    "nome",
    "cpf_cnpj"
  ]
}